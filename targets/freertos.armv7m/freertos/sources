# Support both old FreeRTOS structure (Source/) and new FreeRTOS-Kernel
# Detect which structure is being used
ifeq ($(wildcard $(FREERTOSPATH)/FreeRTOS-Kernel/croutine.c),)
# Old structure
FREERTOS_KERNEL_PATH := $(FREERTOSPATH)/Source
FREERTOS_PORTABLE_PATH := $(FREERTOSPATH)/Source/portable/GCC/ARM_CM3
FREERTOS_MEMMANG_PATH := $(FREERTOSPATH)/Source/portable/MemMang
else
# New structure
FREERTOS_KERNEL_PATH := $(FREERTOSPATH)/FreeRTOS-Kernel
FREERTOS_PORTABLE_PATH := $(FREERTOSPATH)/FreeRTOS-Kernel/portable/GCC/ARM_CM3
FREERTOS_MEMMANG_PATH := $(FREERTOSPATH)/FreeRTOS-Kernel/portable/MemMang
endif

VPATH := $(FREERTOS_KERNEL_PATH): \
         $(FREERTOS_PORTABLE_PATH): \
         $(FREERTOS_MEMMANG_PATH):
         
CSRCS += croutine.c \
         list.c \
         queue.c \
         tasks.c \
         timers.c \
         port.c \
         heap_3.c \
         event_groups.c

CXXSRCS +=
